[Unit]
Description=Flagroom external CTF source worker
After=network-online.target flagroom.service flagroom-xray.service
Wants=network-online.target

[Service]
Type=simple
User=flagroom
Group=flagroom
WorkingDirectory=/opt/flagroom
EnvironmentFile=/opt/flagroom/.env
Environment=SOURCE_WORKER_MODE=external PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/flagroom-playwright
ExecStart=/opt/flagroom/.venv/bin/python /opt/flagroom/source_worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/flagroom/instance

[Install]
WantedBy=multi-user.target
