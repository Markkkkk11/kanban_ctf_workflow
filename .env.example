# Copy to .env; run.sh loads it. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=5000
# Enable behind an HTTPS reverse proxy:
COOKIE_SECURE=0
# Optional, persistent random key; generated in instance/secret otherwise.
# SECRET_KEY=
# Required only when bootstrapping a fresh database:
# ADMIN_LOGIN=admin
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD_HASH=
# Optional comma-separated logins to hide from the public rating:
# RATING_EXCLUDED_LOGINS=
# DATABASE=instance/board.db
# Production: run source_worker.py as a separate service.
# SOURCE_WORKER_MODE=external
# Optional path to a system Chromium executable.
# SOURCE_CHROMIUM_PATH=/usr/bin/chromium
# Optional local SOCKS5 sidecars, tried left-to-right without direct fallback.
# SOURCE_SOCKS_PROXIES=socks5://127.0.0.1:18789,socks5://127.0.0.1:18790

# Optional credentials for an external source. Sent only to this exact origin.
# SOURCE_AUTH_ORIGIN=https://ctf.example
# SOURCE_CTFD_TOKEN=
# Or use the session cookie of your team account:
# SOURCE_COOKIE='session=...'
